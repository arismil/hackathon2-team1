AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT="https://gtgh-09-26.openai.azure.com/"
OPENAI_API_VERSION="2024-12-01-preview"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4.1-mini"



AZURE_EMBEDDING_ENDPOINT="https://gtgh-embed.openai.azure.com/openai/deployments/text-embedding-3-small/embeddings?api-version=2023-05-15"
AZURE_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
AZURE_OPENAI_API_VERSION="2023-05-15"

# ---------------------------------------------------------------- RAG
# azure = Azure OpenAI embeddings (real runs) | hash = offline lexical embeddings (tests/demo without Azure)
EMBEDDING_PROVIDER=azure

# ---------------------------------------------------------------- MCP
# Local dev: MCP server on localhost. docker-compose overrides this with http://mcp-server:8001/mcp
MCP_SERVER_URL=http://localhost:8001/mcp
# remote = streamable HTTP with automatic in-process fallback | local = in-process MCP server only
MCP_MODE=remote
# Demo of FR14: set on the MCP server to simulate an outage of specific tools
# MCP_FAIL_TOOLS=search_vendor_documents

# ---------------------------------------------------------------- Langfuse (local docker stack)
# Dev-only keys, pre-provisioned by docker-compose (LANGFUSE_INIT_*). Change them for any shared deployment.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-nfs-local-dev
LANGFUSE_SECRET_KEY=sk-lf-nfs-local-dev
# Host port for the Langfuse UI (change if 3000 is taken)
LANGFUSE_WEB_PORT=3000
